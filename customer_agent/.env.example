# Copy to .env (or export in your shell) to enable AI features.
# Without a key the app still works fully using the built-in rule-based agent.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini

# Where the SQLite database lives (optional).
# CRM_DB_PATH=./data/crm.db

# --- Onboarding / 2FA ---
# DEV mode returns the OTP in the API response so the flow is testable without
# an SMS/email provider. Set to 0 in production (and wire a real sender).
CRM_DEV_OTP=1

# --- External connectors (all optional; features degrade gracefully) ---
# Herbalife portal (browser automation) — used only for the distributor's own account:
# HERBALIFE_USERNAME=
# HERBALIFE_PASSWORD=
# HERBALIFE_PORTAL_URL=
# Social (Meta Graph API):
# META_GRAPH_TOKEN=
# META_ACCOUNT_IDS=
# Email monitor (IMAP):
# EMAIL_IMAP_HOST=
# EMAIL_USERNAME=
# EMAIL_PASSWORD=
# Content inspiration / news search:
# NEWS_SEARCH_API_KEY=
# Website builder:
# GOOGLE_STITCH_API_KEY=
# Mobile push:
# FCM_SERVER_KEY=
